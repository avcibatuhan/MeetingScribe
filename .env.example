# Copy this file to .env and fill in the keys you want to use.
#   cp .env.example .env
#
# You can also manage every key from inside the app: the ⚙ button
# in the top bar. Nothing here is required to launch the app.

# ---------------------------------------------------------------
# Transcription (speech -> text)
# ---------------------------------------------------------------
# TRANSCRIBE_MODE = deepgram | local
#   deepgram : cloud, fast, tells you who is speaking
#   local    : Whisper on your own GPU, private, no speaker labels
TRANSCRIBE_MODE=deepgram

# Needed only for deepgram mode.  https://console.deepgram.com
DEEPGRAM_API_KEY=

# ---------------------------------------------------------------
# Translation (text -> another language)
# ---------------------------------------------------------------
# Translation providers are managed in the app: API Keys -> Add provider.
# They are stored in providers.json, not here.
#
# On the very first launch, a key placed here is imported automatically:
# GEMINI_API_KEY=

# ---------------------------------------------------------------
# Audio sources  (set these from "Audio" in the sidebar)
# ---------------------------------------------------------------
CAPTURE_SYSTEM=1          # record what your speakers play (the meeting)
CAPTURE_MIC=0             # also record your own microphone
# OUTPUT_DEVICE=default
# MIC_DEVICE=default
# MIC_GAIN=1.0

# ---------------------------------------------------------------
# Preferences
# ---------------------------------------------------------------
TARGET_LANGUAGE=Turkish
CEFR_LEVEL=B2 · natural
DEBUG=1

# --- tuning, safe to leave alone -------------------------------
# BATCH_SIZE=20             # transcript lines per translation request
# REPLY_CONTEXT_LINES=15    # how much conversation the reply button sees
# AUTO_SUMMARY=1            # summarize when you press Stop
# SUMMARY_MIN_LINES=5       # skip auto-summary for very short sessions
# AUTOSAVE_SECONDS=30
# LOCAL_PAUSE_MS=250        # silence that ends an utterance (local mode)
